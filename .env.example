# CamGuid Environment Configuration
# Copy this file to .env and set your values, or generate a secure set with:
#     ./scripts/generate-secrets.sh
#
# The services FAIL TO START if JWT_SECRET / ENCRYPTION_KEY / *_SIGNING_SECRET
# are missing or still set to a CHANGE_ME placeholder.

# Database
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Security — generate with scripts/generate-secrets.sh
#   JWT secret:   openssl rand -hex 32
#   Encryption:   openssl rand -hex 32  (AES-256-GCM key, 64 hex chars)
JWT_SECRET=CHANGE_ME_JWT_SECRET
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_64_HEX

# Shared HMAC secret for signing stream access tokens (api + relay must match)
CAMGUID_STREAM_SIGNING_SECRET=CHANGE_ME_STREAM_SIGNING_SECRET

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Scanner
SCANNER_TIMEOUT=60
SCANNER_CONCURRENCY=50
# Host port the scanner listens on (nginx proxies /scan to it). Kept off 8081
# to avoid clashes with other host services.
SCANNER_PORT=8083
# Abuse prevention: max concurrent scans; min seconds between scans per user
SCANNER_MAX_CONCURRENT=1
SCANNER_MIN_INTERVAL=60

# Streams
STREAM_IDLE_TIMEOUT=60
STREAM_MAX_SESSIONS=20
HLS_SEGMENT_DURATION=2

# Snapshots (Live Wall thumbnails)
SNAPSHOT_INTERVAL=30
SNAPSHOT_WIDTH=640

# Auth abuse prevention (api): failed login attempts per window per IP+username
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60

# Audit log retention (days); logs are deleted after this
AUDIT_RETENTION_DAYS=90

# Optional: set a known initial password for the bootstrap admin instead of a
# randomly generated one. The admin is still forced to change it on first login.
# BOOTSTRAP_ADMIN_PASSWORD=

# --- NVR Service (Python/FastAPI) ---

# Fernet encryption key for NVR passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NVR_ENCRYPTION_KEY=CHANGE_ME_NVR_ENCRYPTION_KEY

# Secret for signing stream access tokens (matches CAMGUID_STREAM_SIGNING_SECRET)
NVR_STREAM_SIGNING_SECRET=CHANGE_ME_STREAM_SIGNING_SECRET

# Stream token TTL in seconds
NVR_STREAM_TOKEN_TTL=300

# FFprobe timeout for RTSP validation
NVR_FFMPEG_TIMEOUT=10

# ONVIF support
NVR_ONVIF_ENABLED=false