# CamGuid Environment Configuration
# Copy this file to .env and set your values

# Database
DB_PASSWORD=camguid_secure_password_change_me

# Security (auto-generated on first boot if empty)
JWT_SECRET=
ENCRYPTION_KEY=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Scanner
SCANNER_TIMEOUT=60
SCANNER_CONCURRENCY=50

# Streams
STREAM_IDLE_TIMEOUT=60
STREAM_MAX_SESSIONS=20
HLS_SEGMENT_DURATION=2

# Snapshots (Live Wall thumbnails)
SNAPSHOT_INTERVAL=30
SNAPSHOT_WIDTH=640

# --- NVR Service (Python/FastAPI) ---

# Fernet encryption key for NVR passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NVR_ENCRYPTION_KEY=

# Secret for signing stream access tokens
NVR_STREAM_SIGNING_SECRET=change-me-to-a-long-random-string

# Stream token TTL in seconds
NVR_STREAM_TOKEN_TTL=300

# FFprobe timeout for RTSP validation
NVR_FFMPEG_TIMEOUT=10

# ONVIF support
NVR_ONVIF_ENABLED=false
