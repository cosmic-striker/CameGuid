# NVR Service Environment Configuration
# Copy this to .env and set your values

# Database (same PostgreSQL instance as the Go backend)
NVR_DATABASE_URL=postgresql+asyncpg://camguid:camguid_secure_password_change_me@db:5432/camguid

# Encryption key for NVR passwords (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NVR_ENCRYPTION_KEY=

# Secret for signing stream access tokens
NVR_STREAM_SIGNING_SECRET=change-me-to-a-long-random-string

# Stream token TTL in seconds (5 minutes default)
NVR_STREAM_TOKEN_TTL=300

# FFprobe timeout for RTSP validation (seconds)
NVR_FFMPEG_TIMEOUT=10

# ONVIF support (disable if unreliable)
NVR_ONVIF_ENABLED=false

# Server
NVR_HOST=0.0.0.0
NVR_PORT=8090

# Logging: debug | info | warning | error
NVR_LOG_LEVEL=info
